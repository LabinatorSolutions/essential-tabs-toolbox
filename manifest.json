{
  "manifest_version": 3,
  "name": "Essential Tabs Toolbox",
  "version": "1.0.0",
  "description": "Open a pasted list of links, list and copy your tabs (by site too), sort them by URL inside tab groups, close duplicates, and restore recently closed tabs.",
  "author": "Labinator",
  "developer": {
    "name": "Labinator",
    "url": "https://labinator.com/"
  },
  "homepage_url": "https://github.com/LabinatorSolutions/essential-tabs-toolbox",
  "icons": {
    "16": "icon.svg",
    "32": "icon.svg",
    "48": "icon.svg",
    "96": "icon.svg",
    "128": "icon.svg"
  },
  "permissions": ["tabs", "storage", "cookies", "sessions"],
  "action": {
    "default_title": "Essential Tabs Toolbox",
    "default_icon": {
      "16": "icon.svg",
      "32": "icon.svg",
      "48": "icon.svg"
    }
  },
  "background": {
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "essential-tabs-toolbox@labinator.com",
      "strict_min_version": "159.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  }
}
